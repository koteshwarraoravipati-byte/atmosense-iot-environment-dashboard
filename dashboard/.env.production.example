# Atmosense production configuration
PORT=3000
MOCK_DATA=false
AWS_IOT_ENDPOINT=your-endpoint.iot.us-east-1.amazonaws.com
MQTT_TOPIC=environment/dht11
CERT_DIR=../secrets

# Auth provider: demo or supabase
AUTH_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Supabase service-role keys and private certificates must never be committed.
# The current server keeps a local telemetry fallback for demo mode; use Supabase
# tables/RLS or a managed telemetry store before multi-user production.
