PORT=3000
AWS_IOT_ENDPOINT=YOUR_ENDPOINT.iot.us-east-1.amazonaws.com
MQTT_TOPIC=environment/dht11
CERT_DIR=../secrets
# Keep true for the safe classroom demo; set false only after AWS IoT certificates are provisioned.
MOCK_DATA=true
# Use demo for local/classroom accounts. Use supabase only after the schema and redirect URL are configured.
AUTH_PROVIDER=demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
